# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Cloud Text-to-Speech API key, used by server/src/routes/tts.routes.ts
# to generate real Gujarati (and Hindi/English) audio server-side, instead of
# depending on the user's device having a Gujarati voice installed.
# Get one from: https://console.cloud.google.com/apis/credentials
# (Cloud Text-to-Speech API must be enabled on the project first.)
GOOGLE_TTS_API_KEY=

# Already used elsewhere in the server - keep these if you have them set:
# DATABASE_URL=
# JWT_SECRET=
